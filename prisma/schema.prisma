generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model UserPreferences {
  id                String   @id @default(cuid())
  ketoMode          String   @default("flexible") // strict, flexible, low_carb
  avoidFish         Boolean  @default(false)
  avoidPork         Boolean  @default(false)
  avoidDairy        Boolean  @default(false)
  maxCookingMinutes Int      @default(20)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  userId            String? // null = legacy pre-multiuser row, claimed by the first registered user
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

model Product {
  id              String   @id @default(cuid())
  name            String
  brand           String?
  source          String   @default("manual") // manual, mercadona
  mercadonaId     String?  @unique
  category        String // meat, fish, eggs, dairy, vegetables, fruit, nuts, oils, sauces, drinks, other
  ketoScore       Int      @default(3) // 0-5
  // Available carbohydrates, excluding fiber, for known convention; unknown legacy values retained only for recovery.
  netCarbsPer100g Float?
  carbsPer100g    Float? // OFF available carbohydrates (NOT total), g/100 g or 100 ml for liquids.
  fiberPer100g    Float?
  nutritionConvention String @default("unknown") // available_excluding_fiber or unknown; provenance/confidence remains nutritionSource.
  nutritionSource String   @default("category") // openfoodfacts, manual, category (no nutrition data: score is a category estimate)
  proteinPer100g  Float?
  fatPer100g      Float?
  caloriesPer100g Float?
  unitPrice       Float?
  packageQuantity Float? // Physical content per commercial package; never inferred from nutrition/name.
  packageUnit     String?
  referencePrice  String?
  imageUrl        String?
  tags            String   @default("[]") // JSON array string
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Null manual owners are legacy: hidden from catalog discovery, never auto-claimed.
  ownerId           String?
  owner             User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId, source])

  pantryItems       PantryItem[]
  recipeIngredients RecipeIngredient[]
  shoppingListItems ShoppingListItem[]
}

model PantryItem {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Float?
  unit      String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String? // null = legacy pre-multiuser row, claimed by the first registered user
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, unit])
}

model Recipe {
  id              String   @id @default(cuid())
  title           String
  description     String
  mealTypes       String // JSON array: ["breakfast","lunch","dinner","snack"]
  prepTimeMinutes Int
  difficulty      String // very_easy, easy, medium
  ketoLevel       String // strict, moderate, low_carb
  tags            String   @default("[]") // JSON array
  steps           String // JSON array of strings
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ingredients RecipeIngredient[]
  weeklyMeals WeeklyMeal[]
}

model RecipeIngredient {
  id        String   @id @default(cuid())
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  quantity  String?
  optional  Boolean  @default(false)
}

model ShoppingListItem {
  id            String   @id @default(cuid())
  productId     String?
  product       Product? @relation(fields: [productId], references: [id])
  name          String
  quantity      String?
  requiredQuantity Float?
  requiredUnit String?
  originalIngredientText String? // Exact RecipeIngredient.quantity, not reconstructed.
  sourceType String @default("legacy") // legacy, manual, recipe, meal, weekly-plan
  sourceKey String? // JSON tuple of real origin IDs; unique within account.
  sourceContributions String? // KH-027 versioned JSON: original slot needs and virtual stock allocation.
  purchaseQuantity Float? // Packages selected to buy; null for ambiguous legacy.
  pantryItemId String? // Exact stock row affected, retained even if that row is removed.
  pantryDeltaUnit String?
  checked       Boolean  @default(false)
  reason        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String? // null = legacy pre-multiuser row, claimed by the first registered user
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, sourceKey])

  // What buying this item did to the pantry, so un-buying reverses exactly that (null = not bought / bought before tracking).
  pantryDelta   Float?
  pantryCreated Boolean  @default(false) // true if that purchase created the pantry row

  @@index([userId])
}

model WeeklyPlan {
  id        String       @id @default(cuid())
  weekStart DateTime // Monday of the week
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  meals     WeeklyMeal[]
  userId    String? // null = legacy pre-multiuser row, claimed by the first registered user
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}

model WeeklyMeal {
  id        String     @id @default(cuid())
  planId    String
  plan      WeeklyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  recipeId  String?
  recipe    Recipe?    @relation(fields: [recipeId], references: [id])
  dayOfWeek Int // 0=Monday, 6=Sunday
  mealType  String // breakfast, lunch, dinner
  createdAt DateTime   @default(now())

  @@unique([planId, dayOfWeek, mealType])
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String? // null = Google-only account
  googleId        String?   @unique // Google `sub`
  createdAt       DateTime  @default(now())
  emailVerifiedAt DateTime?
  termsAcceptedAt DateTime?
  termsVersion    String?
  adultConfirmedAt DateTime?

  manualProducts    Product[]
  sessions          Session[]
  authTokens        AuthToken[]
  preferences       UserPreferences[]
  pantryItems       PantryItem[]
  shoppingListItems ShoppingListItem[]
  weeklyPlans       WeeklyPlan[]
}

model Session {
  id        String   @id // sha256 of the cookie token — a DB leak can't be replayed
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuthToken {
  id        String    @id // sha256 of the emailed token — a DB leak can't be replayed
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // reset, verify
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}
