# SQLite file path used by Prisma (better-sqlite3 adapter).
DATABASE_URL="file:./dev.db"

# Resend API key for verification and password-reset emails.
RESEND_API_KEY=

# Unsplash API key for recipe image backfill (optional — falls back to
# placeholder images if unset). Get one at https://unsplash.com/developers.
UNSPLASH_ACCESS_KEY=

# Google login (optional — the "Continuar con Google" button only shows when both are set).
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback  (also http://localhost:3000/... for dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
